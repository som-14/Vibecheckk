# This file provides example environment variable definitions for VibeCheck.

# Database configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_placeholder
POSTGRES_DB=vibecheck_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres_password_placeholder@localhost:5432/vibecheck_db

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# App security & API settings
SECRET_KEY=secret_key_placeholder
ACCESS_TOKEN_EXPIRE_MINUTES=15
API_V1_STR=/api/v1

# RS256 JWT Keys (Provide paths to key files or PEM formatted strings)
# Dev keys can be generated using: python scripts/generate_keys.py
JWT_PRIVATE_KEY_PATH=jwt_rs256.key
JWT_PUBLIC_KEY_PATH=jwt_rs256.key.pub
JWT_ALGORITHM=RS256
